{
  "name": "gas-app-kit",
  "version": "0.4.0",
  "description": "Several environments, a policy gate and one-command rollback for Google Apps Script projects",
  "type": "module",
  "license": "MIT",
  "author": "juhyeonni",
  "keywords": [
    "google-apps-script",
    "apps-script",
    "gas",
    "clasp",
    "deploy",
    "deployment",
    "rollback",
    "environments",
    "multi-environment",
    "ci",
    "google-workspace",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gas-app": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "prepare": "tsc --build --force",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepack": "pnpm run build",
    "check:publish": "publint && attw --pack --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^25.2.2",
    "esbuild": "^0.28.2",
    "publint": "^0.3.24",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "esbuild": ">=0.21",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juhyeonni/gas-app-kit.git"
  },
  "bugs": {
    "url": "https://github.com/juhyeonni/gas-app-kit/issues"
  },
  "homepage": "https://github.com/juhyeonni/gas-app-kit#readme"
}
